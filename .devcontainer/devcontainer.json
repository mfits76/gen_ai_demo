{
  "name": "GenAI Integration Hub",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -e \".[dev]\" && cp .env.example .env",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "postAttachCommand": "echo 'Run: python scripts/start_server.py  or  python examples/run_demo.py'"
}
