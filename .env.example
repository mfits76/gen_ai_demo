# Application
APP_NAME=GenAI Integration Hub
DEBUG=false
API_KEY=demo-api-key-change-in-production

# JWT (OAuth2-style bearer tokens for demo)
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# LLM providers (optional — mock provider works without keys)
DEFAULT_LLM_PROVIDER=mock

# Local Ollama (e.g. qwen2.5:0.5b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Data governance
PII_REDACTION_ENABLED=true
ALLOWED_DATA_REGIONS=EU,CH
